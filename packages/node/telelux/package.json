{
  "name": "telelux",
  "version": "0.0.0",
  "description": "Agent transcript tooling for Node.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thekevinscott/telelux.git",
    "directory": "packages/node/telelux"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "vite build",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test_unit": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.4.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1"
  }
}

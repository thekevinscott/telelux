{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "*.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}

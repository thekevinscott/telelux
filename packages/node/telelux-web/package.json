{
  "name": "telelux-web",
  "version": "0.0.0",
  "private": true,
  "description": "Internal frontend workspace for the telelux static HTML viewer. Never published; the built artifact ships inside the Python wheel.",
  "license": "MIT",
  "repository": "https://github.com/thekevinscott/telelux",
  "type": "module",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter telelux-element build",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "pretypecheck": "pnpm --filter telelux-element build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest_unit": "pnpm --filter telelux-element build",
    "test_unit": "vitest run",
    "test_integration": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.4.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "telelux-element": "workspace:*"
  }
}
